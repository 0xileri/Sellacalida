// Compiles contracts/*.cash into contracts/artifacts/*.json.
// Run: npm run compile   (tests/artifacts.test.ts fails if artifacts are stale)
import { compileFile } from 'cashc';
import { existsSync, readFileSync, writeFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';

const dir = join(process.cwd(), 'contracts');
for (const file of readdirSync(dir).filter((f) => f.endsWith('.cash'))) {
  const artifact = compileFile(join(dir, file));
  const out = join(dir, 'artifacts', file.replace(/\.cash$/, '.json'));
  // keep the previous updatedAt when the bytecode is unchanged, so recompiling is reproducible
  if (existsSync(out)) {
    const prev = JSON.parse(readFileSync(out, 'utf8'));
    if (prev.bytecode === artifact.bytecode && prev.updatedAt) artifact.updatedAt = prev.updatedAt;
  }
  writeFileSync(out, JSON.stringify(artifact, null, 2) + '\n');
  // typed twin for the SDK (literal ABI types give type-checked unlock functions)
  const tsOut = out.replace(/\.json$/, '.ts');
  writeFileSync(
    tsOut,
    `// generated by scripts/compile-contracts.mts from ${file}; do not edit\nexport default ${JSON.stringify(artifact, null, 2)} as const;\n`,
  );
  const bytes = artifact.bytecode.split(' ').length;
  console.log(`${file} -> ${out} (${bytes} asm tokens)`);
}
