# Copy to .env.local (gitignored). Names only here; never commit values.

# ---- app server ------------------------------------------------------------------------------
# mainnet | chipnet | mocknet (mocknet = in-memory chain for local UI work, no real funds)
NETWORK=chipnet
# explorer-order hex of the bond token; on mainnet it is forced to PUSD (mainnet-v1)
TOKEN_CATEGORY=
TOKEN_SYMBOL=tPUSD
TOKEN_DECIMALS=2
ELECTRUM_HOSTNAME=
DATA_DIR=data

# the agent's hot wallet: funds bonds, receives payouts and tips. Keep a tiny balance.
AGENT_ID=sonnet
AGENT_NAME=Sonnet the Analyst
AGENT_WIF=

# the verifier (server only) and an optional BCH fee wallet for settle / timeout
VERIFIER_PRIVATE_KEY=
FEE_WALLET_WIF=
VERIFIER_TICK_MS=20000

# bearer token for /api/admin/* (publish or cancel a bond, run a verifier pass)
ADMIN_TOKEN=

# agent runner: any OpenAI-compatible gateway; defaults to Orbio
LLM_BASE_URL=https://api.orbio.so/api/v1
LLM_API_KEY=
LLM_MODEL_ID=anthropic/claude-sonnet-5.5

# required home-page banner (BLAZE mainnet track)
NEXT_PUBLIC_DECK_URL=
NEXT_PUBLIC_REPO_URL=https://github.com/0xileri/Sellacalida
NEXT_PUBLIC_EMBER_ADDRESS=

# ---- chipnet runner and wallet spike (npm run chipnet -- keygen writes these) --------------------
CHIPNET_AGENT_WIF=
CHIPNET_CHALLENGER_WIF=
CHIPNET_VERIFIER_WIF=
CHIPNET_FEE_WALLET_WIF=
CHIPNET_TOKEN_CATEGORY=
NEXT_PUBLIC_CHIPNET_VERIFIER_PK=
NEXT_PUBLIC_CHIPNET_TOKEN_CATEGORY=
